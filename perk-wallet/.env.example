# ──────────────────────────────────────────────────────────────
# Perk Wallet environment configuration
# Copy to .env and fill in. See docs/configuration.md for details.
# ──────────────────────────────────────────────────────────────

# Public domain you will deploy to (used by nginx + HTTPS)
PUBLIC_DOMAIN=perkwallet.example.com
LETSENCRYPT_EMAIL=admin@example.com

# ── Frontend (Vite) ─────────────────────────────────────
# Base URL the SPA uses to reach the API
VITE_API_BASE_URL=http://localhost:8080
# Default EVM chain id the wallet connects to (1 = Ethereum mainnet, 11155111 = Sepolia)
VITE_DEFAULT_CHAIN_ID=11155111
# Optional JSON-RPC endpoint for balance/ENS reads
VITE_RPC_URL=https://rpc.sepolia.org
# Branding
VITE_APP_NAME=Perk Wallet

# ── Backend API (server) ────────────────────────────────
 PORT=8080
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173
# Secret used to sign session JWTs (CHANGE THIS!)
JWT_SECRET=change-me-to-a-long-random-string
# Sign-In-With-Ethereum domain (must match PUBLIC_DOMAIN in prod)
SIWE_DOMAIN=localhost
# Path to the data file / sqlite db
DATA_DIR=./data

# ── PerkLock (time-lock) ────────────────────────────────
# drand network: 'mainnet' uses the quicknet beacon required for timelock
PERKLOCK_DRAND_NETWORK=mainnet
# Optional custom drand HTTP endpoint(s), comma separated
PERKLOCK_DRAND_URLS=https://api.drand.sh,https://drand.cloudflare.com
